table 'gold energy_consumption_validated'
	lineageTag: 19f54046-c899-423a-9efb-2cf015d981bf

	measure 'Total Validated Consumption kWh' =
			
			SUM(
			    'gold energy_consumption_validated'[validated_kwh_consumption]
			)
		formatString: #,##0.0 "kWh"
		lineageTag: 4968f009-2f8b-43b7-8bd1-b445c725385b

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Meters Included' =
			
			DISTINCTCOUNT(
			    'gold energy_consumption_validated'[energy_meter_key]
			)
		formatString: 0
		lineageTag: bc022c9d-1ae2-40b9-b7e7-ce86687259fd

	measure 'Average Daily Consumption kWh' =
			
			AVERAGEX(
			    VALUES(
			        'gold energy_consumption_validated'[reading_date_saudi]
			    ),
			    [Total Validated Consumption kWh]
			)
		lineageTag: 53e991a3-8e21-4f80-bfab-3b136fc506af

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Consumption by Time Period kWh' =
			
			CALCULATE(
			    SUM(
			        'gold energy_consumption_validated'[validated_kwh_consumption]
			    ),
			    'gold energy_consumption_validated'[interval_quality] = "NORMAL_INTERVAL"
			)
		lineageTag: 0a31495a-6cd1-4b3f-8780-66b9a6173abd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Highest Consumption Period' =
			
			VAR PeriodTable =
			    ADDCOLUMNS(
			        ALL(
			            'gold energy_consumption_validated'[Time Period]
			        ),
			        "@Consumption",
			            CALCULATE(
			                [Total Validated Consumption kWh]
			            )
			    )
			
			VAR TopPeriod =
			    TOPN(
			        1,
			        PeriodTable,
			        [@Consumption], DESC
			    )
			
			RETURN
			    MAXX(
			        TopPeriod,
			        'gold energy_consumption_validated'[Time Period]
			    )
		lineageTag: 7d4d820a-4ffc-4039-9694-8ed2ccd97e2c

	measure 'Peak Period Consumption kWh' =
			
			VAR PeriodTable =
			    ADDCOLUMNS(
			        ALL(
			            'gold energy_consumption_validated'[Time Period]
			        ),
			        "@Consumption",
			            CALCULATE(
			                [Total Validated Consumption kWh]
			            )
			    )
			
			VAR TopPeriod =
			    TOPN(
			        1,
			        PeriodTable,
			        [@Consumption], DESC
			    )
			
			RETURN
			    MAXX(
			        TopPeriod,
			        [@Consumption]
			    )
		lineageTag: 6ecf2875-66ed-4862-8b6b-b29e203800f7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Peak Period Share' =
			
			DIVIDE(
			    [Peak Period Consumption kWh],
			    [Total Validated Consumption kWh],
			    0
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 16a055bb-ea95-4c82-8812-47eb4ebbe9cc

	measure 'Time Period Share' =
			
			DIVIDE(
			    [Total Validated Consumption kWh],
			    CALCULATE(
			        [Total Validated Consumption kWh],
			        REMOVEFILTERS(
			            'gold energy_consumption_validated'[Time Period]
			        ),
			        REMOVEFILTERS(
			            'gold energy_consumption_validated'[Time Period Display]
			        )
			    ),
			    0
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: e4e947c6-ce94-48b4-83c5-a68bcd11b1b7

	measure 'Time Period Share Bar' =
			
			[Time Period Share]
		lineageTag: f595c4e1-1697-4c02-8546-64a31e7b3362

		annotation PBI_FormatHint = {"isGeneralNumber":true}

