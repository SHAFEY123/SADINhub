	column reading_timestamp_utc
		dataType: dateTime
		formatString: General Date
		lineageTag: 7b6b5e69-d196-4d4e-a2e6-d8fdaeb69db3
		summarizeBy: none
		sourceColumn: reading_timestamp_utc

		variation Variation
			isDefault
			relationship: 74057616-e675-478e-8b0e-d839fab4004f
			defaultHierarchy: LocalDateTable_82e41652-3b65-4d76-8d69-1daa5b618543.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	column reading_timestamp_saudi
		dataType: dateTime
		formatString: General Date
		lineageTag: 5c041293-044c-4c29-9100-a571d15dba99
		summarizeBy: none
		sourceColumn: reading_timestamp_saudi

		variation Variation
			isDefault
			relationship: 57ea509d-c882-40e8-a749-6dd128146ddf
			defaultHierarchy: LocalDateTable_8a0dccc5-14b6-47c4-a065-74f3d37b9aac.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	column reading_date_saudi
		dataType: dateTime
		formatString: Long Date
		lineageTag: 6cf5457b-fe34-406d-9be9-b7c1464fc105
		summarizeBy: none
		sourceColumn: reading_date_saudi

		variation Variation
			isDefault
			relationship: 79fa15fb-054e-4569-8fe5-7c475014a9fd
			defaultHierarchy: LocalDateTable_aa7590bb-29f6-477f-820f-7e820bb9915c.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column active_energy_cumulative_kwh
		dataType: double
		lineageTag: ff3b8b22-cbb2-4834-8bef-e143d3eb593d
		summarizeBy: sum
		sourceColumn: active_energy_cumulative_kwh

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column previous_valid_timestamp
		dataType: dateTime
		formatString: General Date
		lineageTag: cd0d490e-28e3-43d3-b2d9-cf21b37230a4
		summarizeBy: none
		sourceColumn: previous_valid_timestamp

		variation Variation
			isDefault
			relationship: 1ede1b47-438e-4498-a625-76e6adb5e76d
			defaultHierarchy: LocalDateTable_64d239ec-b7b6-42ea-b48e-3d341ed72c7c.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	column previous_valid_kwh
		dataType: double
		lineageTag: e03ce195-acf7-4da9-a6af-910b167670e8
