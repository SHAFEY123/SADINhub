	column interval_quality
		dataType: string
		lineageTag: 18b13cfe-87d3-48c4-922a-93e52f93a672
		summarizeBy: none
		sourceColumn: interval_quality

		annotation SummarizationSetBy = Automatic

	column gap_minutes
		dataType: double
		lineageTag: 187ea7cc-066b-4a1e-bf87-2fe56a152769
		summarizeBy: sum
		sourceColumn: gap_minutes

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Reading Month UTC' =
			
			DATE(
			    YEAR('gold energy_consumption_validated'[reading_timestamp_utc]),
			    MONTH('gold energy_consumption_validated'[reading_timestamp_utc]),
			    1
			)
		formatString: General Date
		lineageTag: d2e54285-b067-4c3a-92ed-5c5c8a386604
		summarizeBy: none

		variation Variation
			isDefault
			relationship: 48849a34-7524-4819-908b-4bed542949e8
			defaultHierarchy: LocalDateTable_9881a707-29e7-4823-998f-a1eb299a65c1.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	column 'Day Type' =
			
			VAR DayNumber =
			    WEEKDAY(
			        'gold energy_consumption_validated'[reading_date_saudi],
			        2
			    )
			RETURN
			IF(
			    DayNumber IN {5, 6},
			    "Weekend",
			    "Weekday"
			)
		lineageTag: 8358c884-7a5b-42c2-b3a9-7625f4686cef
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Time Period' =
			
			VAR ReadingTime =
			    TIME(
			        HOUR('gold energy_consumption_validated'[reading_timestamp_saudi]),
			        MINUTE('gold energy_consumption_validated'[reading_timestamp_saudi]),
			        SECOND('gold energy_consumption_validated'[reading_timestamp_saudi])
			    )
			
			RETURN
			SWITCH(
			    TRUE(),
			
			    ReadingTime >= TIME(4,0,0)
			        && ReadingTime < TIME(8,1,0),
			        "4am to 8am",
			
			    ReadingTime >= TIME(8,1,0)
			        && ReadingTime < TIME(17,1,0),
			        "8:01am to 5pm",
			
			    "5:01pm to 3:59am"
			)
		lineageTag: 17016d6a-5e87-43e1-bcf8-82ea9d2f9d63
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Time Period Display' =
			
			SWITCH(
			    'gold energy_consumption_validated'[Time Period],
			    "4am to 8am", "4:00 AM – 8:00 AM",
			    "8:01am to 5pm", "8:01 AM – 5:00 PM",
			    "5:01pm to 3:59am", "5:01 PM – 3:59 AM"
			)
		lineageTag: c8032cc0-d8b7-4cb5-917a-e1424b472d37
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Reading Hour Saudi' =
			
			HOUR(
			    'gold energy_consumption_validated'[reading_timestamp_saudi]
			)
		formatString: 0
		lineageTag: 86a3dcf3-debc-45c0-93c1-1e495f24d083
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Reading Month Saudi' =
			
			DATE(
			    YEAR('gold energy_consumption_validated'[reading_timestamp_saudi]),
			    MONTH('gold energy_consumption_validated'[reading_timestamp_saudi]),
			    1
			)
		formatString: General Date
		lineageTag: ad7a1f32-39e2-4f50-80ab-0460d14b259a
		summarizeBy: none

		variation Variation
			isDefault
			relationship: f7aec97b-8dc5-475b-a980-c83f0349ac0c
			defaultHierarchy: LocalDateTable_1029b4f1-c65a-4fbd-b56f-eb9dc83fd6c6.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	partition 'gold energy_consumption_validated' = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database("localhost:5432", "sadinhub"),
				    gold_energy_consumption_validated = Source{[Schema="gold",Item="energy_consumption_validated"]}[Data]
				in
				    gold_energy_consumption_validated

