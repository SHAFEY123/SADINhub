		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Reading Hour UTC' =
			
			HOUR(
			    'gold energy_raw'[reading_timestamp_utc]
			)
		formatString: 0
		lineageTag: d0123bd1-a5d6-4df6-a965-1ee839154382
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Quarter Label' =
			
			"Q" & QUARTER ( 'gold energy_raw'[reading_timestamp_utc] )
		lineageTag: aedba4f1-aab7-44a5-8e3e-ce81f190d1fc
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Reading Timestamp Saudi' =
			
			'gold energy_raw'[reading_timestamp_utc] + TIME(3, 0, 0)
		formatString: General Date
		lineageTag: e3c31b2c-879b-4880-b3d0-dd3c95df8056
		summarizeBy: none

		variation Variation
			isDefault
			relationship: 6d8e8694-3d3d-4cf7-8bb0-1329ac9eb346
			defaultHierarchy: LocalDateTable_5732de40-c744-4741-9234-6c16b2371938.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	column 'Operational Date' =
			
			VAR SaudiTimestamp =
			    'gold energy_raw'[Reading Timestamp Saudi]
			
			VAR ReadingDate =
			    DATE(
			        YEAR(SaudiTimestamp),
			        MONTH(SaudiTimestamp),
			        DAY(SaudiTimestamp)
			    )
			
			VAR ReadingTime =
			    TIME(
			        HOUR(SaudiTimestamp),
			        MINUTE(SaudiTimestamp),
			        SECOND(SaudiTimestamp)
			    )
			
			RETURN
			    IF(
			        ReadingTime < TIME(4, 0, 0),
			        ReadingDate - 1,
			        ReadingDate
			    )
		formatString: General Date
		lineageTag: 78025992-68ee-48f3-b765-85a02c94c108
		summarizeBy: none

		variation Variation
			isDefault
			relationship: 0d9f2587-5ea0-4aac-9ead-ca77310eaed4
			defaultHierarchy: LocalDateTable_86cc33fe-bb6a-43e6-8413-a9727be2a777.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

