table 'gold energy_raw'
	lineageTag: 84ee2afb-3f08-4b9c-aea8-87a89a5db854

	measure 'Reading Count' = COUNTROWS('gold energy_raw')
		formatString: 0.00
		lineageTag: c4bd3ea1-467a-48de-8e5c-2c11168c783f

		changedProperty = IsHidden

	measure 'Negative active power TkW Readings' = CALCULATE([Reading Count], 'gold energy_raw'[active_power_total_kw] < 0)
		formatString: 0.000
		lineageTag: bebb18e9-475f-46e1-b397-bb170d313bee

		changedProperty = IsHidden

	measure 'Min TkW' = MIN('gold energy_raw'[active_power_total_kw])
		lineageTag: f0dc70ee-92bf-4972-a024-e3bc4b3ba50d

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Meters' =
			
			DISTINCTCOUNT('gold energy_raw'[energy_meter_key])
		formatString: 0
		lineageTag: 4ceb754d-aaf2-4b08-b14a-62319a190837

		changedProperty = IsHidden

	measure 'Amp1 Mismatch Readings' =
			
			CALCULATE(
			    [Reading Count],
			    'gold energy_raw'[status_amp1] IN {"Major Issue", "Major Problem"}
			)
		formatString: 0
		lineageTag: e2715dce-da78-4534-801e-8e7af8c74b20

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Amp2 Mismatch Readings' =
			
			CALCULATE(
			    [Reading Count],
			    'gold energy_raw'[status_amp2] IN {"Major Issue", "Major Problem"}
			)
		formatString: 0
		lineageTag: 299b8db5-1a66-40dd-bcb2-e0b028c5a177

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Amp3 Mismatch Readings' =
			
			CALCULATE(
			    [Reading Count],
			    'gold energy_raw'[status_amp3] IN {"Major Issue", "Major Problem"}
			)
		formatString: 0
		lineageTag: d6ef2144-4dd5-40cc-af66-6c5c360fe390

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Max Current Mismatch' =
			
			MAX(
			    [Amp1 Mismatch Readings],
			    MAX(
			        [Amp2 Mismatch Readings],
			        [Amp3 Mismatch Readings]
			    )
			)
		formatString: 0
		lineageTag: e579d492-b0d9-4bbe-a769-c0b60ecf0208

		changedProperty = IsHidden

	measure 'Meters Above Current Threshold' =
			
			COUNTROWS(
			    FILTER(
			        VALUES('gold energy_raw'[energy_meter_key]),
			        [Max Current Mismatch] > 100
			    )
			)
		formatString: 0
		lineageTag: 705c48bf-eb02-4f43-ba76-79cd39a7b403

		changedProperty = IsHidden

	measure 'Total Phase Mismatch Events' =
			
			[Amp1 Mismatch Readings]
			+ [Amp2 Mismatch Readings]
			+ [Amp3 Mismatch Readings]
		formatString: 0
		lineageTag: d3f980ea-65e1-44d1-acb6-4b3899493ecf

		changedProperty = IsHidden

	measure 'Any-Phase Mismatch Readings' =
			
			CALCULATE(
			    [Reading Count],
			    FILTER(
			        'gold energy_raw',
			        'gold energy_raw'[status_amp1] IN {"Major Issue", "Major Problem"}
			        ||
			        'gold energy_raw'[status_amp2] IN {"Major Issue", "Major Problem"}
			        ||
			        'gold energy_raw'[status_amp3] IN {"Major Issue", "Major Problem"}
			    )
			)
		formatString: 0
		lineageTag: 9d3db21b-6c20-4b03-aff7-c32d1e347698

		changedProperty = IsHidden

	measure 'PF1 Critical %' =
			
			DIVIDE(
			    CALCULATE(
			        [Reading Count],
			        'gold energy_raw'[status_pf1] = "Critical"
			    ),
			    [Reading Count],
			    0
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: ce83438f-a52d-4dc0-a436-5b7747cf3d30

		changedProperty = IsHidden

	measure 'PF2 Critical %' =
			
			DIVIDE(
			    CALCULATE(
			        [Reading Count],
			        'gold energy_raw'[status_pf2] = "Critical"
			    ),
			    [Reading Count],
			    0
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 2a35b747-c34c-464c-87e6-6a80a3f2b814

		changedProperty = IsHidden

	measure 'PF3 Critical %' =
			
			DIVIDE(
			    CALCULATE(
			        [Reading Count],
			        'gold energy_raw'[status_pf3] = "Critical"
			    ),
			    [Reading Count],
			    0
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 8c2b5f43-2727-446a-8ebe-543631357bb2

		changedProperty = IsHidden

	measure 'PF Critical Spread' =
			
			VAR P1 = [PF1 Critical %]
			VAR P2 = [PF2 Critical %]
			VAR P3 = [PF3 Critical %]
			VAR Highest =
			    MAX(P1, MAX(P2, P3))
			VAR Lowest =
			    MIN(P1, MIN(P2, P3))
			RETURN
			    Highest - Lowest
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: c0317a42-057d-43e1-8a17-29f93313ae56

		changedProperty = IsHidden

	measure 'PF Asymmetric Meters' =
			
			COUNTROWS(
			    FILTER(
			        VALUES('gold energy_raw'[energy_meter_key]),
			        [PF Critical Spread] > 0.65
			    )
			)
		formatString: 0
		lineageTag: 5a2f53cf-d411-47b8-8b0c-55e533711105

		changedProperty = IsHidden

	measure 'Voltage Frequency Exceptions' =
			
			CALCULATE(
			    [Reading Count],
			    'gold energy_raw'[status_hz] IN {"Invalid","Critical","Review Required","Problematic"}
			)
			+
			CALCULATE(
			    [Reading Count],
			    'gold energy_raw'[status_v1] IN {"Invalid","Critical","Review Required","Problematic"}
			)
			+
			CALCULATE(
			    [Reading Count],
			    'gold energy_raw'[status_v2] IN {"Invalid","Critical","Review Required","Problematic"}
			)
			+
			CALCULATE(
			    [Reading Count],
			    'gold energy_raw'[status_v3] IN {"Invalid","Critical","Review Required","Problematic"}
			)
			+
			CALCULATE(
			    [Reading Count],
			    'gold energy_raw'[status_vn1] IN {"Invalid","Critical","Review Required","Problematic"}
			)
			+
			CALCULATE(
			    [Reading Count],
			    'gold energy_raw'[status_vn2] IN {"Invalid","Critical","Review Required","Problematic"}
			)
			+
			CALCULATE(
			    [Reading Count],
			    'gold energy_raw'[status_vn3] IN {"Invalid","Critical","Review Required","Problematic"}
			)
		formatString: 0
		lineageTag: 98b4a6c5-4b4b-411b-abfa-d88fdeeaf7d8

		changedProperty = IsHidden

	measure 'Any Phase Mismatch Row' =
			
			VAR P1 =
			    SELECTEDVALUE('gold energy_raw'[status_amp1])
			VAR P2 =
			    SELECTEDVALUE('gold energy_raw'[status_amp2])
			VAR P3 =
			    SELECTEDVALUE('gold energy_raw'[status_amp3])
			
			RETURN
			IF(
			    P1 IN {"Major Issue", "Major Problem"}
			        || P2 IN {"Major Issue", "Major Problem"}
			        || P3 IN {"Major Issue", "Major Problem"},
			    1,
			    0
			)
		formatString: 0
		lineageTag: fde758c9-aa81-4a24-a93f-8aa965ba140c

		changedProperty = IsHidden

	measure 'Negative active power P1 Readings' =
			
			CALCULATE(
			    [Reading Count],
			    'gold energy_raw'[active_power_phase_1_kw] < 0
			)
		formatString: 0
		lineageTag: b215128d-f22d-45bd-807c-ad50f1491783

		changedProperty = IsHidden

	measure 'Negative active power P2 Readings' =
			
			CALCULATE(
			    [Reading Count],
			    'gold energy_raw'[active_power_phase_2_kw] < 0
			)
		formatString: 0
		lineageTag: d96007e6-954d-40ef-a666-dc6e48c00e14

		changedProperty = IsHidden

	measure 'Negative active power P3 Readings' =
			
			CALCULATE(
			    [Reading Count],
			    'gold energy_raw'[active_power_phase_3_kw] < 0
			)
		formatString: 0
		lineageTag: 1b588d79-0887-4f66-9952-a1296d656fc3

		changedProperty = IsHidden

	measure 'Any Negative Power Row' =
			
			VAR P1 =
			    SELECTEDVALUE('gold energy_raw'[active_power_phase_1_kw])
			VAR P2 =
			    SELECTEDVALUE('gold energy_raw'[active_power_phase_2_kw])
			VAR P3 =
			    SELECTEDVALUE('gold energy_raw'[active_power_phase_3_kw])
			VAR PT =
			    SELECTEDVALUE('gold energy_raw'[active_power_total_kw])
			RETURN
			IF(
			    P1 < 0
			        || P2 < 0
			        || P3 < 0
			        || PT < 0,
			    1,
			    0
			)
		formatString: 0
		lineageTag: fbdbcb87-8da8-4861-a7cd-db62e41ad8b8

		changedProperty = IsHidden

	measure 'Voltage Frequency Flag Count' =
			
			VAR Metric =
			    SELECTEDVALUE(
			        'Voltage Frequency Metric Selector'[Measurement]
			    )
			
			RETURN
			SWITCH(
			    Metric,
			
			    "Frequency",
			        CALCULATE(
			            [Reading Count],
			            'gold energy_raw'[status_hz]
			                IN {"Invalid", "Critical", "Review Required", "Problematic"}
			        ),
			
			    "V1",
			        CALCULATE(
			            [Reading Count],
			            'gold energy_raw'[status_v1]
			                IN {"Invalid", "Critical", "Review Required", "Problematic"}
			        ),
			
			    "V2",
			        CALCULATE(
			            [Reading Count],
			            'gold energy_raw'[status_v2]
			                IN {"Invalid", "Critical", "Review Required", "Problematic"}
			        ),
			
			    "V3",
			        CALCULATE(
			            [Reading Count],
			            'gold energy_raw'[status_v3]
			                IN {"Invalid", "Critical", "Review Required", "Problematic"}
			        ),
			
			    "VN1",
			        CALCULATE(
			            [Reading Count],
			            'gold energy_raw'[status_vn1]
			                IN {"Invalid", "Critical", "Review Required", "Problematic"}
			        ),
			
			    "VN2",
			        CALCULATE(
			            [Reading Count],
			            'gold energy_raw'[status_vn2]
			                IN {"Invalid", "Critical", "Review Required", "Problematic"}
			        ),
			
			    "VN3",
			        CALCULATE(
			            [Reading Count],
			            'gold energy_raw'[status_vn3]
			                IN {"Invalid", "Critical", "Review Required", "Problematic"}
			        )
			)
		formatString: 0
		lineageTag: dc1e162a-3cf1-4b7f-8a10-34887964db3b

		changedProperty = IsHidden

	measure 'Selected Voltage Frequency Flag Row' =
			
			VAR Metric =
			    SELECTEDVALUE(
			        'Voltage Frequency Metric Selector'[Measurement]
			    )
			
			VAR SHz = SELECTEDVALUE('gold energy_raw'[status_hz])
			VAR SV1 = SELECTEDVALUE('gold energy_raw'[status_v1])
			VAR SV2 = SELECTEDVALUE('gold energy_raw'[status_v2])
			VAR SV3 = SELECTEDVALUE('gold energy_raw'[status_v3])
			VAR SVN1 = SELECTEDVALUE('gold energy_raw'[status_vn1])
			VAR SVN2 = SELECTEDVALUE('gold energy_raw'[status_vn2])
			VAR SVN3 = SELECTEDVALUE('gold energy_raw'[status_vn3])
			
			RETURN
			SWITCH(
			    TRUE(),
			
			    Metric = "Frequency"
			        && SHz IN {"Invalid","Critical","Review Required","Problematic"}, 1,
			
			    Metric = "V1"
			        && SV1 IN {"Invalid","Critical","Review Required","Problematic"}, 1,
			
			    Metric = "V2"
			        && SV2 IN {"Invalid","Critical","Review Required","Problematic"}, 1,
			
			    Metric = "V3"
			        && SV3 IN {"Invalid","Critical","Review Required","Problematic"}, 1,
			
			    Metric = "VN1"
			        && SVN1 IN {"Invalid","Critical","Review Required","Problematic"}, 1,
			
			    Metric = "VN2"
			        && SVN2 IN {"Invalid","Critical","Review Required","Problematic"}, 1,
			
			    Metric = "VN3"
			        && SVN3 IN {"Invalid","Critical","Review Required","Problematic"}, 1,
			
			    0
			)
		formatString: 0
		lineageTag: 613cd22d-e2e7-4af5-994c-a4ecb2462b25

		changedProperty = IsHidden

	measure 'Previous kWh' =
			
			VAR CurrentMeter =
			    SELECTEDVALUE('gold energy_raw'[energy_meter_key])
			
			VAR CurrentTime =
			    SELECTEDVALUE('gold energy_raw'[reading_timestamp_utc])
			
			RETURN
			MAXX(
			    TOPN(
			        1,
			        FILTER(
			            ALL('gold energy_raw'),
			            'gold energy_raw'[energy_meter_key] = CurrentMeter
			                && 'gold energy_raw'[reading_timestamp_utc] < CurrentTime
			                && NOT ISBLANK(
			                    'gold energy_raw'[active_energy_cumulative_kwh]
			                )
			        ),
			        'gold energy_raw'[reading_timestamp_utc],
			        DESC
			    ),
			    'gold energy_raw'[active_energy_cumulative_kwh]
			)
		lineageTag: cad3086a-39b7-444a-ad9f-42ad2fb7ae62

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Previous kWh Timestamp' =
			
			VAR CurrentMeter =
			    SELECTEDVALUE('gold energy_raw'[energy_meter_key])
			
			VAR CurrentTime =
			    SELECTEDVALUE('gold energy_raw'[reading_timestamp_utc])
			
			RETURN
			MAXX(
			    TOPN(
			        1,
			        FILTER(
			            ALL('gold energy_raw'),
			            'gold energy_raw'[energy_meter_key] = CurrentMeter
			                && 'gold energy_raw'[reading_timestamp_utc] < CurrentTime
			                && NOT ISBLANK(
			                    'gold energy_raw'[active_energy_cumulative_kwh]
			                )
			        ),
			        'gold energy_raw'[reading_timestamp_utc],
			        DESC
			    ),
			    'gold energy_raw'[reading_timestamp_utc]
			)
		formatString: General Date
		lineageTag: c2ac8157-3bd9-4ce8-98ae-945ab5a8e894

		changedProperty = IsHidden

	measure 'Previous Reading Timestamp' =
			
			VAR CurrentMeter =
			    SELECTEDVALUE('gold energy_raw'[energy_meter_key])
			
			VAR CurrentTime =
			    SELECTEDVALUE('gold energy_raw'[reading_timestamp_utc])
			
			RETURN
			MAXX(
			    TOPN(
			        1,
			        FILTER(
			            ALL('gold energy_raw'),
			            'gold energy_raw'[energy_meter_key] = CurrentMeter
			                && 'gold energy_raw'[reading_timestamp_utc] < CurrentTime
			        ),
			        'gold energy_raw'[reading_timestamp_utc],
			        DESC
			    ),
			    'gold energy_raw'[reading_timestamp_utc]
			)
		formatString: General Date
		lineageTag: 0a89f302-c246-425e-bbf1-d68d3b02fb33

		changedProperty = IsHidden

	measure 'Reading Gap Minutes' =
			
			VAR CurrentTime =
			    SELECTEDVALUE('gold energy_raw'[reading_timestamp_utc])
			
			VAR PreviousTime =
			    [Previous Reading Timestamp]
			
			RETURN
			IF(
			    NOT ISBLANK(CurrentTime)
			        && NOT ISBLANK(PreviousTime),
			    DIVIDE(
			        DATEDIFF(PreviousTime, CurrentTime, SECOND),
			        60.0
			    )
			)
		lineageTag: 6a9ad3c6-ada1-40ee-9db9-a6107bd5eb00

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Max Reading Gap Minutes' =
			
			MAXX(
			    VALUES('gold energy_raw'[reading_timestamp_utc]),
			    [Reading Gap Minutes]
			)
		lineageTag: e37667db-86d1-41da-970d-232f022a92cd

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Selected Meter Max Gap Days' =
			
			VAR SelectedMeter =
			    SELECTEDVALUE('gold energy_raw'[meter_label])
			
			RETURN
			CALCULATE(
			    MAX('gold energy_reading_gaps'[gap_days]),
			    TREATAS(
			        {SelectedMeter},
			        'gold energy_reading_gaps'[meter_label]
			    )
			)
		lineageTag: 9fc097e5-6e97-415f-a214-00cd95fd30f3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Peak Active Power kW' =
			
			MAX(
			    'gold energy_raw'[active_power_total_kw]
			)
		lineageTag: 252ab3f6-adb8-490a-bc84-1aec0786d02e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Active Power kW' =
			
			AVERAGE(
			    'gold energy_raw'[active_power_total_kw]
			)
		lineageTag: 5753f8bb-5183-4d68-9838-e405be402a94

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Selected Meter Consumption kWh' =
			
			VAR SelectedMeter =
			    SELECTEDVALUE('gold energy_raw'[meter_label])
			
			RETURN
			CALCULATE(
			    [Total Validated Consumption kWh],
			    TREATAS(
			        {SelectedMeter},
			        'gold energy_consumption_validated'[meter_label]
			    )
			)
		lineageTag: c8b726ad-fd73-417b-9efa-664d22d6bffc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Selected Meter Consumption Display' =
			
			VAR SelectedMeter =
			    SELECTEDVALUE('gold energy_raw'[meter_label])
			
			VAR Consumption =
			    [Selected Meter Consumption kWh]
			
			RETURN
			IF(
			    CONTAINSSTRING(SelectedMeter, "ZN.13-"),
			    "Excluded",
			    FORMAT(Consumption, "#,##0.0") & " kWh"
			)
		lineageTag: be451314-570a-4a51-b671-b30843c60d7c

	measure 'Active Meters' =
			
			DISTINCTCOUNT ( 'gold energy_raw'[meter_label] )
		formatString: 0
		lineageTag: e93de189-0768-4f7e-88d9-0906a02d4838

	measure 'kWh Counter Decrements' =
			
			CALCULATE(
			    [Reading Count],
			    'gold energy_raw'[status_kwh] = "Invalid"
			)
		formatString: 0
		lineageTag: fec0bc51-1480-434c-b890-2b403f12939c

	measure 'Total active power Negative Readings' =
			
			COALESCE([Negative active power P1 Readings], 0)
			+ COALESCE([Negative active power P2 Readings], 0)
			+ COALESCE([Negative active power P3 Readings], 0)
		formatString: 0
		lineageTag: 574ef83b-4a9f-44a4-8385-c27a31aed00d

	measure 'Negative PF P1 Readings' =
			
			CALCULATE(
			    [Reading Count],
			    'gold energy_raw'[power_factor_phase_1] < 0
			)
		formatString: 0
		lineageTag: b17c6193-e452-4930-b0ff-eccb26544016

	measure 'Negative PF P2 Readings' =
			
			CALCULATE(
			    [Reading Count],
			    'gold energy_raw'[power_factor_phase_2] < 0
			)
		formatString: 0
		lineageTag: 4cde025d-a4b3-44d3-80cc-e91fa23bcdd0

	measure 'Negative PF P3 Readings' =
			
			CALCULATE(
			    [Reading Count],
			    'gold energy_raw'[power_factor_phase_3] < 0
			)
		formatString: 0
		lineageTag: fff6c93b-fba4-4cac-bc31-71e690ed10a8

	measure 'Total Negative PF Readings' =
			
			COALESCE([Negative PF P1 Readings], 0)
			+ COALESCE([Negative PF P2 Readings], 0)
			+ COALESCE([Negative PF P3 Readings], 0)
		formatString: 0
		lineageTag: c9c40d93-4ddf-46f7-8a3d-d92a80f9982b

	measure Measure
		lineageTag: 578c30e7-120c-4494-bc32-5f5eff1793fa

		annotation 43dbc3e8-3a1c-4b6f-9923-b49ff7d6691c = True

	measure 'Selected PF Row' =
			
			VAR SelectedPhase =
			    SELECTEDVALUE(
			        'PF Phase Selector'[Selection],
			        "Any Phase"
			    )
			
			VAR PF1 =
			    MAX('gold energy_raw'[power_factor_phase_1])
			
			VAR PF2 =
			    MAX('gold energy_raw'[power_factor_phase_2])
			
			VAR PF3 =
			    MAX('gold energy_raw'[power_factor_phase_3])
			
			RETURN
			SWITCH(
			    SelectedPhase,
			
			    "Phase 1",
			        IF(PF1 < 0, 1, 0),
			
			    "Phase 2",
			        IF(PF2 < 0, 1, 0),
			
			    "Phase 3",
			        IF(PF3 < 0, 1, 0),
			
			    "Any Phase",
			        IF(
			            PF1 < 0
			            || PF2 < 0
			            || PF3 < 0,
			            1,
			            0
			        ),
			
			    0
			)
		formatString: 0
		lineageTag: ff42e122-0e6c-4b38-a370-3b548edee989

